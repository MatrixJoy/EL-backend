VOA_ENV=development
VOA_HTTP_ADDR=:8080
VOA_SHUTDOWN_TIMEOUT=10s
VOA_FETCH_TIMEOUT=20s
VOA_CRAWL_DELAY=1500ms
VOA_USER_AGENT=VOALearningApp/0.1 (+https://example.com/contact)
VOA_DATABASE_URL=postgres://postgres:postgres@localhost:5432/voa_learning?sslmode=disable
VOA_REDIS_ADDR=localhost:6379
VOA_OBJECT_BUCKET=voa-learning-raw
VOA_OBJECT_ENDPOINT=127.0.0.1:9000
VOA_OBJECT_ACCESS_KEY=minioadmin
VOA_OBJECT_SECRET_KEY=minioadmin
VOA_OBJECT_USE_TLS=false
LEARNING_APPLE_CLIENT_ID=cn.wozdou.ela
# Configure all four together to enable Apple sign-in. Never commit their values.
LEARNING_APPLE_TEAM_ID=
LEARNING_APPLE_KEY_ID=
LEARNING_APPLE_PRIVATE_KEY_BASE64=
LEARNING_APPLE_TOKEN_ENCRYPTION_KEY=
